#!/usr/bin/emacs --script
(require 'org)

(setq min-argc 2)
(if (< (length argv) min-argc)
    (error "Not enough arguments") argv)

(load-file "conf.el")
(load "blog")

(setq old-tree-id (nth 0 argv))
(setq new-tree-id (nth 1 argv))

(if (not (file-exists-p database-path))
    (progn
      (let* ((j-blog-conf (json-parse-string (blog-git-object-show (nth 0 (blog-git-tree-fetch-objects new-tree-id (list blog-conf-file-path))))))
	     (screen-sizes (gethash "screen_sizes" j-blog-conf)))
	(if screen-sizes
	    (blog-create-database database-path (seq-map 'eval screen-sizes))
	  (signal 'blog-configuration-error (list (format-message "screen_sizes was not defined in blog configuration file `%s'" blog-conf-file-path)))))))

;; This connection object will be used to refer to the database from now on
(setq blog-db (sqlite-open database-path))
(if (not (sqlite-pragma blog-db "foreign_keys = ON;"))
    (error "Could not set 'foreign_keys = ON' pragma"))



(defun update-authors (db new-authors new-authors-file-hash)
  "Update authors list in the database with new author list NEW-AUTHORS."
  (condition-case caught-err
      (progn
	(blog-delete-missing-authors blog-db new-authors)
	(seq-map (lambda (current-author)
		   (blog-author-delete-outdated-avatar-sets current-author db))
		 new-authors)
	(blog-push-authors-to-database db new-authors)
	(sqlite-execute db
			"INSERT INTO authors_file_hash_table (id, hash) VALUES (1, ?) ON CONFLICT DO UPDATE SET id = 1, hash = ?;"
			(list new-authors-file-hash new-authors-file-hash)))))

(defun get-files-from-diff-report (diff-report)
  "Given a diff report DIFF-REPORT, return a list of files that have been
modified or added."
  (let ((final-list ()) (added-files ()) (modified-files ()) (deleted-files ()))
    (dolist (current-symbol (list :added :modified :deleted))
      (setq final-list (append final-list
			       (list current-symbol
				     (seq-map (lambda (record)
						(blog-git-object-path (blog-git-diff-report-record-old record)))
					      (plist-get diff-report current-symbol))))))
    final-list))

(defun get-added-or-modified-posts (diff-report authors-list &optional existing-files)
  (let ((final-list ()))
    (dolist (current-diff-record (append (plist-get diff-report :added)
					 (plist-get diff-report :modified)))
      (setq final-list (append final-list
			       (blog-fetch-posts-from-git-object (blog-git-diff-report-record-new current-diff-record)
								 authors-list
								 t
								 (if existing-files
								     (append final-list existing-files)
								   final-list)
								 t))))
      final-list))

(defun get-posts-to-update (undecided-posts-alist)
  "Initialize posts-to-update as a list of posts whose database entries
need to be created or updated."
  (let ((final-list ()))
	  (dolist (current-undecided-post-assoc undecided-posts-alist)
	    (let* ((current-undecided-post (nth 1 current-undecided-post-assoc))
		   (stored-delta-query-result (sqlite-select blog-db
							    "SELECT hash = ? AND src_file = ? FROM posts WHERE nominal_id=?;" ; A post needs to be readded if it's moved files, or if its contents have changed
							    (list (blog-post-hash current-undecided-post)
								  (blog-post-src-file-path current-undecided-post)
								  (blog-post-nominal-id current-undecided-post)))))
	      (if (or (seq-empty-p stored-delta-query-result)
		      (= (nth 0 (nth 0 stored-delta-query-result))))
		  (push current-undecided-post final-list))))
	  final-list))

(defun upsert-post (db post)
  "UPSERT blogpost POST into database DB."
  (let ((post-path (concat (blog-post-nominal-id post) ".html")))
		(sqlite-execute db
				"INSERT INTO files (path, hash, size) VALUES (?, ?, ?) ON CONFLICT (path) DO UPDATE SET path=?, hash=?, size=?;"
				(let* ((post-html (blog-post-publish post (file-name-concat blog-export-directory post-path) t))
				       (query-args (list post-path (blog-hash post-html) (length post-html))))
				  (append query-args query-args)))
		(sqlite-execute db
				"INSERT INTO posts (nominal_id, title, subtitle, author, date_published, date_modified, stub, file, hash, src_file) VALUES (?, ?, ?, (SELECT id FROM authors WHERE nominal_id=?), ?, ?, ?, (SELECT id FROM files WHERE path=?), ?, ?) ON CONFLICT (nominal_id) DO UPDATE SET nominal_id=?, title=?, subtitle=?, author=(SELECT id FROM authors WHERE nominal_id=?), date_published=?, date_modified=?, stub=?, file=(SELECT id FROM files WHERE path=?), hash=?, src_file=?;"
				(let* ((post-nominal-id (blog-post-nominal-id post))
				      (post-title (blog-post-title post))
				      (post-subtitle (blog-post-subtitle post))
				      (post-author-nominal-id (blog-author-nominal-id (blog-post-author post)))
				      (post-date-published (blog-post-date-published post))
				      (post-date-modified (blog-post-date-modified post))
				      (post-stub (blog-post-stub post))
				      (post-hash (blog-post-hash post))
				      (post-src-file (blog-post-src-file-path post))
				      (query-args (list post-nominal-id post-title post-subtitle post-author-nominal-id post-date-published post-date-modified post-stub post-path post-hash post-src-file)))
				  (append query-args query-args)))))

(defun delete-post-by-nominal-id (db post-nominal-id)
  "Delete the post from the database DB whose nominal id is NOMINAL-ID."
      (progn
	(sqlite-execute db "DELETE FROM posts WHERE nominal_id = ?;" (list post-nominal-id))
	(sqlite-execute db "DELETE FROM files WHERE id = (SELECT file FROM posts WHERE nominal_id = ?);" (list post-nominal-id))))

(unwind-protect
    (progn
      (sqlite-transaction blog-db)

      (condition-case caught-err
	  (progn
	    (let* ((new-authors-file-object (nth 0 (blog-git-tree-fetch-objects new-tree-id (list authors-file-path))))
		   (old-authors-file-object (nth 0 (blog-git-tree-fetch-objects old-tree-id (list authors-file-path))))
		   (authors-needs-update nil))
		   (setq authors (blog-load-authors-from-git-object new-authors-file-object avatar-set-size))
		   (setq authors-needs-update (if old-authors-file-object
						  (not (string-equal (blog-hash (blog-git-object-show old-authors-file-object))
								     (blog-hash (blog-git-object-show new-authors-file-object))))
						t))
		   (if authors-needs-update
		       (update-authors blog-db authors (blog-hash (blog-git-object-show new-authors-file-object)))))

	    (setq new-tree (blog-git-tree-fetch-objects new-tree-id blog-files))
	    (setq diff-report (blog-git-generate-diff-report old-tree-id new-tree-id blog-files))

	    ;; Delete posts associated with deleted files
	    (setq diff-report-files (get-files-from-diff-report diff-report))
	    (dolist (current-deleted-file (plist-get diff-report-files :deleted))
	      (sqlite-execute blog-db "DELETE FROM posts WHERE src_file=?;" (list current-deleted-file))
	      (sqlite-execute blog-db "DELETE FROM files WHERE id=(SELECT file FROM posts WHERE src_file=?);" (list current-deleted-file)))

	    ;; Delete all posts that are in the database, but aren't in any tracked files
	    (setq added-or-modified-posts (get-added-or-modified-posts diff-report authors))
	    (setq unchanged-objects (blog-git-diff-report-fetch-unchanged-files diff-report new-tree))
	    (setq unchanged-posts (apply 'append (seq-map (lambda (current-object)
						     (blog-fetch-posts-from-git-object current-object
										       authors
										       t
										       added-or-modified-posts  ; We can forgo checking other unchanged files; we'll assume they don't contain any duplicates
										       (blog-git-object-path current-object)))
							  unchanged-objects)))
	    (setq all-posts (append added-or-modified-posts unchanged-posts))

	    (let ((post-query-results (sqlite-select blog-db "SELECT nominal_id FROM posts;")))
	      (dolist (current-row post-query-results)
		(if (not (assoc (nth 0 current-row) all-posts))
		(delete-post-by-nominal-id blog-db (nth 0 current-row)))))

	    ;; Add to the database, or update, posts that have been created, or changed, respectively
	    (setq posts-to-update (get-posts-to-update added-or-modified-posts))
	    (dolist (current-post posts-to-update)
	      (upsert-post blog-db current-post))
	    (sqlite-commit blog-db))))
    (sqlite-rollback blog-db)
    (sqlite-close blog-db))
